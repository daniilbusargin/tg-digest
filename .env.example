# Telegram Bot API token (получить у @BotFather)
BOT_TOKEN=123456:ABC-DEF...

# Chat ID владельца — бот отвечает только этому id (можно узнать у @userinfobot)
OWNER_CHAT_ID=123456789

# Адрес Ollama (по умолчанию локальный)
OLLAMA_BASE_URL=http://localhost:11434

# Имя модели в Ollama
OLLAMA_MODEL=qwen2.5:7b

# Путь к SQLite БД (приложение и чекпоинтер LangGraph)
DB_PATH=digest.db
LANGGRAPH_DB_PATH=langgraph_checkpoints.db

# Часовой пояс расписания
SCHEDULE_TZ=Europe/Moscow
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
